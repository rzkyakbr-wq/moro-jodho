APP_NAME="Moro Jodho POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-railway-app.up.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ===========================================================
# KONEKSI DATABASE SUPABASE (PostgreSQL)
# Isi sesuai data dari Supabase > Project Settings > Database
# ===========================================================
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-password
PGSSLMODE=require

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

CACHE_STORE=array

QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# PIN KASIR & PEMILIK (ganti sesuai keinginanmu)
POS_KASIR_PIN=kasir123
POS_OWNER_PIN=owner123
